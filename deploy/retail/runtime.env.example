# 复制为私有 runtime.env（0600）；不使用托管站的 SESSION_SECRET。
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
CRYPTO_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://YOUR_IP:11443
DEFAULT_LANGUAGE=zh-CN
VERSION=retail-RELEASE_SHORT_SHA
# 不配置 Redis、托管节点、支付宝或默认试用余额。
